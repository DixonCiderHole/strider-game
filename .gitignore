# Godot cache and imports (rebuilt automatically)
.godot/
.import/
*.tmp

# Exported game builds
/build/
/export/
*.exe
*.pck

# Working files that aren't part of the game
/rigwork/
/debug/
*.blend1

# OS clutter
Thumbs.db
desktop.ini
.DS_Store

# Previews sent in the Claude chat (saved into the project by the app)
/Claude outputs/

# Terrain3D's temporary copy of its DLL while the editor is open
addons/terrain_3d/bin/~*
